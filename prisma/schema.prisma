generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StockStatus {
  available
  booking
  sold
}

enum PhotoSlot {
  front
  back
  side
  tryon
  detail
}

model Product {
  id           String         @id @default(uuid())
  name         String
  category     Int
  value        Int
  size         String
  condition    String
  flaw         String
  photo        String
  illustration Boolean        @default(false)
  status       StockStatus    @default(available)
  bookingUntil DateTime?
  createdAt    DateTime       @default(now())
  photos       ProductPhoto[]
}

model ProductPhoto {
  productId String
  slot      PhotoSlot
  photo     Bytes
  mime      String
  revision  String    @default(uuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, slot])
}

model LoginAttempt {
  client   String @id
  window   Int
  attempts Int

  @@index([window])
}
